<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);sdks/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- TODO: pin until pulumi/pulumi-dotnet restores binary compatibility: 3.109.0+ removed the
         RegisterPackageRequest constructor overload that SDKs generated by `pulumi package add`
         (compiled against the codegen minimum, Pulumi 3.76.1) bind to, causing MissingMethodException. -->
    <PackageReference Include="Pulumi" Version="[3.108.0]" />
  </ItemGroup>

</Project>
